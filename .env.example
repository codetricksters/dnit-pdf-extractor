# Template de variáveis de ambiente do dnit-pdf-extractor.
# Copie para .env e preencha as senhas. O .env não é versionado.
#
#   cp .env.example .env
#
# Em docker-compose.yml a senha do Postgres vem de POSTGRES_PASSWORD e precisa
# ser a mesma que aparece na DATABASE_URL abaixo.

APP_ENV=development

# Conexão do PostgreSQL usada pela aplicação.
# Rodando fora do Docker (o fluxo documentado no README): localhost:5433, a porta
# que o docker-compose.yml publica para o serviço postgres. Só a stack completa
# (`docker compose up -d`) usa "postgres:5432" — e ela define DATABASE_URL direto
# no ambiente do contêiner, não a partir deste arquivo.
DATABASE_URL=postgresql://dnit:TROQUE_ESTA_SENHA@localhost:5433/dnit

# Banco separado usado pela suíte de testes (o schema é recriado a cada teste).
DATABASE_URL_TEST=postgresql://dnit:TROQUE_ESTA_SENHA@localhost:5433/dnit_test

# Backups do banco
BACKUP_DIR=/app/data/backups
BACKUP_RETENTION=14
BACKUP_INTERVAL_HOURS=24

# Só é necessário fora do Docker, e só quando o pg_dump do PATH for de uma versão
# maior que a do servidor (16): um dump gerado por um cliente mais novo não pode
# ser restaurado, então a aplicação se recusa a gerá-lo. Aponte para o cliente
# que corresponde ao servidor, por exemplo /usr/lib/postgresql/16/bin
# PG_BIN=/usr/lib/postgresql/16/bin
